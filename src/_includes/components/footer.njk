<footer class="site-footer">
  <div class="container footer-top">
    <div class="footer-brand">
      <a class="brand" href="{{ '/' | url }}" aria-label="GPTCLONE Blog — página inicial">
        <span class="brand-mark" aria-hidden="true">G</span>
        <span class="brand-text">
          <span class="brand-name">GPTCLONE</span>
          <span class="brand-sub">Journal</span>
        </span>
      </a>
      <p class="footer-tagline">
        Publicação independente sobre inteligência artificial. Notas de investigação,
        diário de projeto e material educativo — em português europeu.
      </p>
      <p class="footer-fine">pt-PT &middot; Licença {{ site.license }} &middot; Projeto independente</p>
    </div>

    <nav class="footer-col" aria-label="Navegação do rodapé">
      <h2 class="footer-heading">Navegação</h2>
      <ul>
        {% for item in navigation %}
          <li><a href="{{ item.url | url }}">{{ item.label }}</a></li>
        {% endfor %}
      </ul>
    </nav>

    <nav class="footer-col" aria-label="Conteúdo do blog">
      <h2 class="footer-heading">Conteúdo</h2>
      <ul>
        <li><a href="{{ '/journal/' | url }}">Jornal</a></li>
        <li><a href="{{ '/ai-research/' | url }}">Investigação em IA</a></li>
        <li><a href="{{ '/academy/' | url }}">Academy</a></li>
        <li><a href="{{ '/pdf-library/' | url }}">Biblioteca PDF</a></li>
        <li><a href="{{ '/audiobook-library/' | url }}">Audiolivros</a></li>
        <li><a href="{{ '/tags/' | url }}">Etiquetas</a></li>
      </ul>
    </nav>

    <div class="footer-col">
      <h2 class="footer-heading">Recursos</h2>
      <ul>
        <li><a href="{{ '/rss.xml' | url }}">Feed RSS</a></li>
        <li><a href="{{ '/sitemap.xml' | url }}">Mapa do site</a></li>
        <li><a href="{{ '/search/' | url }}">Pesquisar</a></li>
        <li><a href="{{ site.github }}" target="_blank" rel="noopener noreferrer">Repositório GitHub</a></li>
      </ul>
    </div>
  </div>

  <div class="container footer-bottom">
    <p class="footer-copy">GPTCLONE Blog &copy; {{ site.year }}. Conteúdo sob licença {{ site.license }}, salvo indicação em contrário.</p>
    <p class="footer-notes">
      <span>Sem rastreio de terceiros</span>
      <a href="#main">Voltar ao topo</a>
    </p>
  </div>

  <p class="footer-wordmark" aria-hidden="true">GPTCLONE</p>
</footer>
