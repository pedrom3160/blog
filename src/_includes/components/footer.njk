<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <a class="brand" href="{{ '/' | url }}" aria-label="GPTCLONE Blog - Início">
        <span class="brand-mark" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 2 2 7l10 5 10-5-10-5Z" />
            <path d="m2 17 10 5 10-5" />
            <path d="m2 12 10 5 10-5" />
          </svg>
        </span>
        <span class="brand-name">GPTCLONE Blog</span>
      </a>
      <p class="footer-tagline">
        Conhecimento, investigação, educação e diário de projeto. Público e gratuito.
      </p>
    </div>

    <nav class="footer-nav" aria-label="Navegação do rodapé">
      <h2 class="footer-heading">Secções</h2>
      <ul>
        {% for item in navigation %}
          <li><a href="{{ item.url | url }}">{{ item.label }}</a></li>
        {% endfor %}
        <li><a href="{{ '/about/' | url }}">Sobre</a></li>
      </ul>
    </nav>

    <div class="footer-meta">
      <h2 class="footer-heading">Recursos</h2>
      <ul>
        <li><a href="{{ '/rss.xml' | url }}">Feed RSS</a></li>
        <li><a href="{{ '/sitemap.xml' | url }}">Mapa do site</a></li>
        <li><a href="{{ site.github }}" target="_blank" rel="noopener noreferrer">Repositório GitHub</a></li>
      </ul>
      <a class="footer-github" href="{{ site.github }}" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" />
          <path d="M9 18c-4.51 2-5-2-7-2" />
        </svg>
      </a>
    </div>
  </div>

  <div class="container footer-bottom">
    <p>GPTCLONE Blog &copy; {{ site.year }}. Conteúdo publicado sob licença {{ site.license }}, salvo indicação em contrário.</p>
    <p>Português Europeu (pt-PT) &middot; Sem rastreio de terceiros &middot; Sem necessidade de conta</p>
  </div>
</footer>
