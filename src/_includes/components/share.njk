{% macro shareButtons(pageUrl, title, label = 'Partilhar') %}
<div class="share">
  <p class="share-label">{{ label }}</p>
  <div class="share-actions">
    <a class="share-btn" href="https://www.facebook.com/sharer/sharer.php?u={{ pageUrl | absoluteUrl | urlencode }}" target="_blank" rel="noopener noreferrer" aria-label="Partilhar no Facebook">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z" /></svg>
    </a>
    <a class="share-btn" href="https://x.com/intent/tweet?url={{ pageUrl | absoluteUrl | urlencode }}&text={{ title | urlencode }}" target="_blank" rel="noopener noreferrer" aria-label="Partilhar no X">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.9 2H22l-6.8 7.8L23 22h-6.3l-4.9-6.4L6.2 22H3l7.3-8.3L2.4 2h6.4l4.5 5.9L18.9 2Zm-1.1 18h1.7L7.4 3.8H5.6L17.8 20Z" /></svg>
    </a>
    <a class="share-btn" href="https://www.linkedin.com/sharing/share-offsite/?url={{ pageUrl | absoluteUrl | urlencode }}" target="_blank" rel="noopener noreferrer" aria-label="Partilhar no LinkedIn">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6zM2 9h4v12H2z" /><circle cx="4" cy="4" r="2" /></svg>
    </a>
    <button class="share-btn" type="button" data-copy-link="{{ pageUrl | absoluteUrl }}" aria-label="Copiar ligação">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.7 1.7" /><path d="M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7l1.7-1.7" /></svg>
    </button>
    <span class="share-status" data-copy-status aria-live="polite"></span>
  </div>
</div>
{% endmacro %}
