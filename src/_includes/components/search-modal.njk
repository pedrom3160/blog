<div class="search-modal" id="search-modal" role="dialog" aria-modal="true" aria-labelledby="search-dialog-title" hidden>
  <div class="search-backdrop" data-search-close></div>
  <div class="search-panel" role="document">
    <h2 class="sr-only" id="search-dialog-title">Pesquisar no GPTCLONE Blog</h2>
    <form class="search-form" id="search-form" role="search">
      <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
        <circle cx="11" cy="11" r="7" />
        <path d="m20 20-4.2-4.2" />
      </svg>
      <label class="sr-only" for="search-input">Termos de pesquisa</label>
      <input
        id="search-input"
        type="search"
        name="q"
        placeholder="Pesquisar artigos, PDFs e audiolivros…"
        autocomplete="off"
      />
      <button type="button" class="search-close" data-search-close aria-label="Fechar pesquisa">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
          <path d="M6 6l12 12M18 6 6 18" />
        </svg>
      </button>
    </form>
    <div class="search-results" id="search-results" aria-live="polite" aria-label="Resultados da pesquisa"></div>
    <p class="search-empty" id="search-empty" hidden>
      Nenhum resultado encontrado. Experimente outro termo.
    </p>
    <p class="search-hint">
      <kbd>Esc</kbd> fechar &middot; <kbd>/</kbd> pesquisar &middot; <a href="{{ '/search/' | url }}">página completa</a>
    </p>
  </div>
</div>
