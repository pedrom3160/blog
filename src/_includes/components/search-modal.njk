<div class="search-modal" id="search-modal" role="dialog" aria-modal="true" aria-label="Pesquisar no GPTCLONE Blog" hidden>
  <div class="search-backdrop" data-search-close></div>
  <div class="search-panel" role="document">
    <form class="search-form" id="search-form" role="search">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="11" cy="11" r="7" />
        <path d="m21 21-4.3-4.3" />
      </svg>
      <input
        id="search-input"
        type="search"
        name="q"
        placeholder="Pesquisar artigos, PDFs, audiolivros..."
        autocomplete="off"
        aria-label="Termos de pesquisa"
      />
      <button type="button" class="search-close" data-search-close aria-label="Fechar pesquisa">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M6 6l12 12M18 6 6 18" />
        </svg>
      </button>
    </form>
    <div class="search-results" id="search-results" aria-live="polite"></div>
    <p class="search-empty" id="search-empty" hidden>
      Nenhum resultado encontrado. Experimente outros termos.
    </p>
    <p class="search-hint">Pressione <kbd>Esc</kbd> para fechar &middot; <kbd>/</kbd> para pesquisar</p>
  </div>
</div>
