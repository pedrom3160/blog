{% import "components/cards.njk" as cards %}

{% macro collectionListing(items, heading, intro, filterLabel = 'Categoria', kicker = 'Secção') %}
{% set filters = items | categories %}

<section class="page-hero">
  <div class="container">
    <p class="eyebrow"><span class="eyebrow-mark" aria-hidden="true"></span>{{ kicker }}</p>
    <div class="page-hero-grid">
      <h1 class="page-title">{{ heading }}</h1>
      <p class="page-lead">{{ intro }}</p>
    </div>
    <p class="page-meta">{{ items.length }} artigo{% if items.length != 1 %}s{% endif %} publicado{% if items.length != 1 %}s{% endif %}</p>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="toolbar" data-collection-filter>
      <div class="field field-search">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
          <circle cx="11" cy="11" r="7" /><path d="m20 20-4.2-4.2" />
        </svg>
        <label class="sr-only" for="listing-search">Pesquisar</label>
        <input id="listing-search" type="search" data-filter-search placeholder="Pesquisar em {{ heading | lower }}…" />
      </div>
      <div class="field field-select">
        <label class="sr-only" for="listing-category">{{ filterLabel }}</label>
        <select id="listing-category" data-filter-category>
          <option value="">{{ filterLabel }}: todos</option>
          {% for filter in filters %}
            <option value="{{ filter.name | lower }}">{{ filter.name }} ({{ filter.count }})</option>
          {% endfor %}
        </select>
      </div>
    </div>

    <div class="card-grid" data-filter-grid>
      {% for item in items %}{{ cards.articleCard(item) }}{% endfor %}
    </div>
    <p class="filter-empty" data-filter-empty hidden>Nenhum resultado encontrado. Ajuste a pesquisa ou o filtro.</p>
  </div>
</section>
{% endmacro %}

{% macro paginationNav(pagination) %}
{% if pagination and pagination.hrefs and pagination.hrefs.length > 1 %}
<nav class="pagination" aria-label="Paginação">
  {% if pagination.href.previous %}
  <a class="pagination-link" href="{{ pagination.href.previous | url }}" rel="prev">&larr; Anteriores</a>
  {% else %}<span class="pagination-link is-disabled" aria-hidden="true">&larr; Anteriores</span>{% endif %}
  <span class="pagination-count">Página {{ pagination.pageNumber + 1 }} de {{ pagination.hrefs.length }}</span>
  {% if pagination.href.next %}
  <a class="pagination-link" href="{{ pagination.href.next | url }}" rel="next">Seguintes &rarr;</a>
  {% else %}<span class="pagination-link is-disabled" aria-hidden="true">Seguintes &rarr;</span>{% endif %}
</nav>
{% endif %}
{% endmacro %}
