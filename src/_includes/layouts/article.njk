---
layout: layouts/base.njk
---
{% import "components/cards.njk" as cards %}
{% set related = related | relatedArticles(collections.articles) %}
<article class="article">
  <div class="container article-container">
    <header class="article-header">
      {% if image %}
        <div class="article-hero">
          <img src="{{ image | url }}" alt="" />
        </div>
      {% endif %}

      <div class="badges">
        {% if category %}<span class="badge badge-category">{{ category }}</span>{% endif %}
        {% for tag in tags %}
          <a class="badge badge-tag" href="{{ ('/tags/' ~ (tag | slug) ~ '/') | url }}">{{ tag }}</a>
        {% endfor %}
      </div>

      <h1 class="article-title">{{ title }}</h1>
      <p class="article-description">{{ description }}</p>

      <div class="article-meta">
        <span class="meta-author">Por {{ author }}</span>
        <time datetime="{{ pubDate | isoDate }}">{{ pubDate | formatDate }}</time>
        {% if updatedDate %}
          <span>Atualizado: <time datetime="{{ updatedDate | isoDate }}">{{ updatedDate | formatDate }}</time></span>
        {% endif %}
        {% if readingTime %}
          <span class="reading-time">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10" />
              <path d="M12 6v6l4 2" />
            </svg>
            {{ readingTime }}
          </span>
        {% endif %}
      </div>
    </header>

    <div class="article-layout">
      <aside class="toc" aria-label="Índice da página">
        <p class="toc-title">Nesta página</p>
        <nav class="toc-nav" id="toc-nav" aria-label="Índice"></nav>
      </aside>

      <div class="article-content" data-article-content>
        {{ content | safe }}
      </div>
    </div>

    {% if related.length %}
      <section class="related">
        <h2 class="related-title">Artigos relacionados</h2>
        <div class="card-grid card-grid-3">
          {% for item in related %}{{ cards.articleCard(item) }}{% endfor %}
        </div>
      </section>
    {% endif %}

    <footer class="article-footer">
      <div class="share">
        <span class="share-label">Partilhar</span>
        <a class="share-btn" href="https://www.facebook.com/sharer/sharer.php?u={{ (page.url | url | absoluteUrl) | urlencode }}" target="_blank" rel="noopener noreferrer" aria-label="Partilhar no Facebook">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z" /></svg>
        </a>
        <a class="share-btn" href="https://x.com/intent/tweet?url={{ (page.url | url | absoluteUrl) | urlencode }}&text={{ title | urlencode }}" target="_blank" rel="noopener noreferrer" aria-label="Partilhar no X">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z" /></svg>
        </a>
        <a class="share-btn" href="https://www.linkedin.com/sharing/share-offsite/?url={{ (page.url | url | absoluteUrl) | urlencode }}" target="_blank" rel="noopener noreferrer" aria-label="Partilhar no LinkedIn">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6zM2 9h4v12H2zM18 18h3v-7a6 6 0 0 0-6-6z" /></svg>
        </a>
      </div>
    </footer>

    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      "headline": {{ title | dump | safe }},
      "description": {{ (description or '') | dump | safe }},
      "datePublished": "{{ pubDate | isoDate }}",
      "dateModified": "{{ (updatedDate or pubDate) | isoDate }}",
      "author": { "@type": "Person", "name": {{ (author or site.author) | dump | safe }} },
      "publisher": { "@type": "Organization", "name": {{ site.title | dump | safe }}, "url": "{{ site.url }}" },
      "mainEntityOfPage": { "@type": "WebPage", "@id": "{{ page.url | absoluteUrl }}" },
      "image": {{ (image or '') | dump | safe }}
    }
    </script>
  </div>
</article>
