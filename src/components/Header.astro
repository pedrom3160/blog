---
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  title?: string;
}

const { title = 'GPTCLONE Blog' } = Astro.props;
---

<header class="sticky top-0 z-50 border-b border-gptclone-purple/20 bg-gptclone-bg/80 backdrop-blur-md">
  <div class="container">
    <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between py-4 lg:py-6">
      <div class="flex items-center gap-3 mb-4 lg:mb-0 lg:order-1">
        <a href="/" class="flex items-center gap-2">
          <div class="w-8 h-8 rounded-lg bg-gptclone-purple flex items-center justify-center shadow-lg shadow-gptclone-purple/30">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#F2EEFF" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round">
              <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
            </svg>
          </div>
          <span class="text-xl font-bold text-gptclone-text gradient-text tracking-tight">
            GPTCLONE
          </span>
          <span class="text-xs font-medium text-gptclone-purple-light bg-gptclone-purple/10 px-2 py-0.5 rounded">BLOG</span>
        </a>
      </div>

      <div class="flex items-center gap-4 lg:order-3">
        <ThemeToggle />
      </div>
    </div>

    <nav class="lg:flex lg:items-center lg:gap-8 mt-4 lg:mt-0 border-t border-gptclone-purple/10 pt-4 lg:pt-0 lg:border-t-0">
      <a href="/" class="px-4 py-2 text-sm font-medium text-gptclone-text/70 hover:text-gptclone-purple-light transition-colors">Início</a>
      <a href="/journal/" class="px-4 py-2 text-sm font-medium text-gptclone-text/70 hover:text-gptclone-purple-light transition-colors">Jornal</a>
      <a href="/ai-research/" class="px-4 py-2 text-sm font-medium text-gptclone-text/70 hover:text-gptclone-purple-light transition-colors">Investigação IA</a>
      <a href="/academy/" class="px-4 py-2 text-sm font-medium text-gptclone-text/70 hover:text-gptclone-purple-light transition-colors">Academia</a>
      <a href="/pdf-library/" class="px-4 py-2 text-sm font-medium text-gptclone-text/70 hover:text-gptclone-purple-light transition-colors">Biblioteca PDF</a>
      <a href="/audiobook-library/" class="px-4 py-2 text-sm font-medium text-gptclone-text/70 hover:text-gptclone-purple-light transition-colors">Audiolivros</a>
    </nav>
  </div>
</header>