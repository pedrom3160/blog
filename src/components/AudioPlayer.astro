---
interface Props {
  src?: string;
  title?: string;
  isPlaceholder?: boolean;
}

const { src, title, isPlaceholder = false } = Astro.props;
---

<div class="card p-6">
  <h3 class="text-lg font-bold text-gptclone-text mb-2">{title || 'Audiolivro'}</h3>

  {isPlaceholder || !src ? (
    <div class="bg-gptclone-surface/50 rounded-lg p-6 text-center flex flex-col items-center gap-3">
      <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#A66BFF" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round">
        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
        <path d="M12 3v12M3 12h18"/>
      </svg>
      <p class="text-sm text-gptclone-text/70">Conteúdo áudio disponível em breve</p>
      <p class="text-xs text-gptclone-text/50">Este é um marcador de posição para futuros audiolivros gerados a partir de materiais educativos do GPTCLONE.</p>
    </div>
  ) : (
    <div>
      <audio
        controls
        src={src}
        class="w-full"
        preload="metadata"
      >
        <p class="text-gptclone-text/70">
          O seu navegador não suporta reprodução de áudio.
        </p>
      </audio>
      <p class="mt-2 text-sm text-gptclone-text/70">
        Reproduza diretamente no navegador ou descarregue o ficheiro.
      </p>
    </div>
  )}
</div>