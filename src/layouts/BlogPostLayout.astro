---
import { getCollection } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import ReadingTime from '../components/ReadingTime.astro';
import SocialShare from '../components/SocialShare.astro';
import { getFormattedDate } from '../utils/date';

interface Props {
  frontmatter: {
    title: string;
    description: string;
    pubDate: Date;
    updatedDate?: Date;
    author: string;
    tags?: string[];
    category?: string;
    readingTime?: string;
    related?: string[];
    image?: string;
  };
  Content: Astro.ComponentProps<any>['Content'];
}

const { frontmatter, Content } = Astro.props;

// Fetch related articles
const collectionType = Astro.url.pathname.includes('ai-research') ? 'ai-research' : 'journal';
const allArticles = await getCollection(collectionType);
const relatedArticles = allArticles.filter(
  (entry) => frontmatter.related?.includes(entry.id) && entry.id !== Astro.params.slug
);

const pubDate = new Date(frontmatter.pubDate);
const updatedDate = frontmatter.updatedDate ? new Date(frontmatter.updatedDate) : null;
const readingTime = frontmatter.readingTime || '';
---

<BaseLayout title={frontmatter.title} description={frontmatter.description} lang="pt-PT">
  <article class="container py-10 md:py-16">
    <header class="mb-10 md:mb-16">
      {frontmatter.image && (
          <div class="h-64 md:h-80 rounded-2xl overflow-hidden mb-6 shadow-lg shadow-gptclone-purple/20 dark:shadow-none border border-gptclone-purple/20 dark:border-gptclone-purple/30">
          <img
            src={frontmatter.image}
            alt=""
            class="w-full h-full object-cover"
            loading="eager"
          />
        </div>
      )}
      <div class="flex flex-wrap gap-2 mb-4">
        {frontmatter.category && (
          <span class="badge badge-category">{frontmatter.category}</span>
        )}
        {frontmatter.tags?.map((tag) => (
          <span class="badge badge-tag">{tag}</span>
        ))}
      </div>
      <h1 class="text-4xl md:text-5xl font-bold text-gptclone-text mb-4 text-balance leading-tight">
        {frontmatter.title}
      </h1>
      <p class="text-lg text-gptclone-text/80 max-w-2xl">
        {frontmatter.description}
      </p>
      <div class="flex flex-wrap items-center gap-4 text-sm text-gptclone-text/60 mt-6">
        <div class="flex items-center gap-2">
          <span class="opacity-70">Por</span>
          <span class="font-medium text-gptclone-text">{frontmatter.author}</span>
        </div>
        <time datetime={pubDate.toISOString()}>
          {getFormattedDate(pubDate)}
        </time>
        {updatedDate && (
          <span class="flex items-center gap-1">
            <span class="opacity-70">Atualizado:</span>
            {getFormattedDate(updatedDate)}
          </span>
        )}
        <ReadingTime content={frontmatter.readingTime || '5 min'} />
      </div>
    </header>

    <div class="prose prose-lg dark:prose-invert max-w-none mb-12">
      <Content />
    </div>

    {frontmatter.related && frontmatter.related.length > 0 && (
      <section class="mb-12">
        <h2 class="text-2xl font-bold text-gptclone-text mb-6">Artigos relacionados</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {relatedArticles.map((entry) => (
            <ArticleCard
              title={entry.data.title}
              description={entry.data.description}
              date={entry.data.pubDate}
              author={entry.data.author}
              tags={entry.data.tags}
              category={entry.data.category}
              readingTime={entry.data.readingTime}
              href={`${collectionType}/${entry.id}/`}
              image={entry.data.image}
            />
          ))}
        </div>
      </section>
    )}

    <section class="border-t border-gptclone-purple/20 dark:border-gptclone-purple/30 pt-8">
      <div class="flex items-center justify-between">
        <SocialShare title={frontmatter.title} url={new URL(Astro.url.pathname, Astro.site?.toString() || 'https://pedrom3160.github.io/blog/').href} />
      </div>
    </section>
  </article>
</BaseLayout>