---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Página não encontrada" description="A página que procura não existe." lang="pt-PT">
  <div class="container py-20 text-center">
    <div class="text-9xl font-bold text-gptclone-purple/20 dark:text-gptclone-purple/40 mb-4">404</div>
    <h1 class="text-3xl font-bold text-gptclone-text mb-4">Página não encontrada</h1>
    <p class="text-gptclone-text/70 mb-8">A página que procura não existe ou foi movida.</p>
    <a href="/" class="btn-primary">Voltar ao início</a>
  </div>
</BaseLayout>