---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import ArticleCard from '../components/ArticleCard.astro';
import { sortByDateDesc } from '../utils/content';

const journal = await getCollection('journal');
const aiResearch = await getCollection('ai-research');
const academy = await getCollection('academy');

const allArticles = sortByDateDesc([...journal, ...aiResearch, ...academy]);
const featuredArticles = allArticles.slice(0, 3);
---

<BaseLayout title="GPTCLONE Blog" description="Conhecimento, investigação, educação e diário de projeto. Acesso público e gratuito sem necessidade de conta." lang="pt-PT">
  <!-- Hero Section -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 bg-[url('/assets/images/welcome-hero.svg')] bg-cover bg-center opacity-60 dark:opacity-40"></div>
    <div class="container relative z-10 py-20 md:py-32 text-center">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-gptclone-purple-100 dark:bg-gptclone-purple-900/30 border border-gptclone-purple-200 dark:border-gptclone-purple-500/30 text-gptclone-purple-700 dark:text-gptclone-purple-300 text-xs font-medium mb-6">
        Público e gratuito · Sem registo necessário
      </div>
      <h1 class="text-5xl md:text-7xl font-bold text-gptclone-text-light dark:text-gptclone-text mb-6 text-balance leading-tight">
        Conhecimento aberto,<br />
        investigação partilhada
      </h1>
      <p class="text-lg md:text-xl text-gptclone-text-light-secondary dark:text-gptclone-text/70 max-w-2xl mx-auto mb-10 leading-relaxed">
        O GPTCLONE Blog é uma plataforma pública de conhecimento, investigação e educação.
        Explore o Jornal, a Biblioteca PDF, a Biblioteca de Audiolivros, Investigação em IA e a Academia.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="journal/" class="btn-primary px-8 py-3 text-base">Explorar o Jornal</a>
        <a href="ai-research/" class="btn-outline px-8 py-3 text-base">Investigação em IA</a>
      </div>
    </div>
  </section>

  <!-- Featured Articles -->
  <section class="py-16 bg-gptclone-bg-light dark:bg-gptclone-bg">
    <div class="container">
      <div class="flex items-center justify-between mb-10">
        <div>
          <h2 class="text-3xl font-bold text-gptclone-text-light dark:text-gptclone-text">Artigos em destaque</h2>
          <p class="text-gptclone-text-light-secondary dark:text-gptclone-text/60 mt-2">Leituras recentes do Jornal e Investigação em IA</p>
        </div>
        <a href="journal/" class="text-sm font-medium text-gptclone-purple-600 dark:text-gptclone-purple-400 hover:underline">Ver todos →</a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {featuredArticles.map((entry) => (
          <ArticleCard
            title={entry.data.title}
            description={entry.data.description}
            date={entry.data.pubDate}
            author={entry.data.author}
            tags={entry.data.tags}
            category={entry.data.category}
            readingTime={entry.data.readingTime}
            href={`${entry.collection}/${entry.id}/`}
            image={entry.data.image}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Content Areas Overview -->
  <section class="py-16">
    <div class="container">
      <h2 class="text-3xl font-bold text-gptclone-text-light dark:text-gptclone-text mb-2 text-center">Áreas de conteúdo</h2>
      <p class="text-gptclone-text-light-secondary dark:text-gptclone-text/60 text-center mb-12 max-w-3xl mx-auto">Explore as principais secções do GPTCLONE Blog.</p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="card p-8 hover:shadow-md transition-shadow">
          <div class="w-12 h-12 rounded-lg bg-gptclone-purple-100 dark:bg-gptclone-purple-900/30 flex items-center justify-center mb-6">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#8b5cf6" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
              <circle cx="8.5" cy="7" r="4" fill="#8b5cf6"></circle>
              <polyline points="17 21 17 13 7 13 7 21"></polyline>
              <polyline points="7 3 7 8 15 8 15 3"></polyline>
              <line x1="12" y1="17" x2="12" y2="13"></line>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-gptclone-text-light dark:text-gptclone-text mb-3">Jornal GPTCLONE</h3>
          <p class="text-gptclone-text-light-secondary dark:text-gptclone-text/70 mb-6">Notícias, atualizações de desenvolvimento, marcos, decisões técnicas e relatórios de progresso.</p>
          <a href="journal/" class="text-sm font-medium text-gptclone-purple-600 dark:text-gptclone-purple-400 hover:underline">Ler mais →</a>
        </div>
        <div class="card p-8 hover:shadow-md transition-shadow">
          <div class="w-12 h-12 rounded-lg bg-blue-100 dark:bg-blue-900/30 flex items-center justify-center mb-6">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#3b82f6" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round">
              <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
              <polyline points="2 17 12 22 22 17"></polyline>
              <polyline points="2 12 12 17 22 12"></polyline>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-gptclone-text-light dark:text-gptclone-text mb-3">Investigação em IA</h3>
          <p class="text-gptclone-text-light-secondary dark:text-gptclone-text/70 mb-6">IA, Machine Learning, Deep Learning, LLMs, Transformers, Tokenização e muito mais.</p>
          <a href="ai-research/" class="text-sm font-medium text-gptclone-purple-600 dark:text-gptclone-purple-400 hover:underline">Ler mais →</a>
        </div>
        <div class="card p-8 hover:shadow-md transition-shadow">
          <div class="w-12 h-12 rounded-lg bg-emerald-100 dark:bg-emerald-900/30 flex items-center justify-center mb-6">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#10b981" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
              <line x1="16" y1="13" x2="8" y2="13"></line>
              <line x1="16" y1="17" x2="8" y2="17"></line>
              <polyline points="10 9 9 9 8 9"></polyline>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-gptclone-text-light dark:text-gptclone-text mb-3">GPTCLONE Academy</h3>
          <p class="text-gptclone-text-light-secondary dark:text-gptclone-text/70 mb-6">Caminhos de aprendizagem estruturados, do iniciante ao avançado.</p>
          <a href="academy/" class="text-sm font-medium text-gptclone-purple-600 dark:text-gptclone-purple-400 hover:underline">Ler mais →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Libraries Preview -->
  <section class="py-16 bg-gptclone-bg-light dark:bg-gptclone-bg">
    <div class="container">
      <div class="flex items-center justify-between mb-10">
        <div>
          <h2 class="text-3xl font-bold text-gptclone-text-light dark:text-gptclone-text">Bibliotecas de recursos</h2>
          <p class="text-gptclone-text-light-secondary dark:text-gptclone-text/60 mt-2">Navegue, filtre e descarregue documentos técnicos, tutoriais e materiais educativos.</p>
        </div>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="card p-8">
          <h3 class="text-xl font-bold text-gptclone-text-light dark:text-gptclone-text mb-3">Biblioteca PDF</h3>
          <p class="text-gptclone-text-light-secondary dark:text-gptclone-text/70 mb-6">Manuais técnicos, tutoriais, documentos de investigação e guias de programação.</p>
          <a href="pdf-library/" class="btn-primary px-6 py-2">Explorar PDFs</a>
        </div>
        <div class="card p-8">
          <h3 class="text-xl font-bold text-gptclone-text-light dark:text-gptclone-text mb-3">Biblioteca de Audiolivros</h3>
          <p class="text-gptclone-text-light-secondary dark:text-gptclone-text/70 mb-6">Material educativo em formato áudio, reproduzível diretamente no navegador.</p>
          <a href="audiobook-library/" class="btn-primary px-6 py-2">Explorar Audiolivros</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>