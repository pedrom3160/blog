---
layout: layouts/base.njk
permalink: /tags/
title: Etiquetas
description: Índice de todas as etiquetas (tags) usadas nos artigos do GPTCLONE Blog.
---
{% import "components/cards.njk" as cards %}

<section class="section">
  <div class="container">
    <header class="section-header">
      <h1>Etiquetas</h1>
      <p class="section-intro">{{ collections.tags.length }} etiqueta(s) usadas nos artigos do GPTCLONE Blog.</p>
    </header>
    <div class="tag-cloud">
      {% for tag in collections.tags | sort %}
        <a class="tag-pill" href="{{ ('/tags/' ~ (tag | slug) ~ '/') | url }}">#{{ tag }}</a>
      {% endfor %}
    </div>
  </div>
</section>
