---
permalink: /sitemap.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url><loc>{{ '/' | absoluteUrl }}</loc><changefreq>weekly</changefreq><priority>1.0</priority></url>
  <url><loc>{{ '/about/' | absoluteUrl }}</loc><changefreq>monthly</changefreq><priority>0.8</priority></url>
  <url><loc>{{ '/donations/' | absoluteUrl }}</loc><changefreq>monthly</changefreq><priority>0.5</priority></url>
  <url><loc>{{ '/journal/' | absoluteUrl }}</loc><changefreq>weekly</changefreq><priority>0.8</priority></url>
  <url><loc>{{ '/ai-research/' | absoluteUrl }}</loc><changefreq>weekly</changefreq><priority>0.8</priority></url>
  <url><loc>{{ '/academy/' | absoluteUrl }}</loc><changefreq>monthly</changefreq><priority>0.7</priority></url>
  <url><loc>{{ '/pdf-library/' | absoluteUrl }}</loc><changefreq>monthly</changefreq><priority>0.6</priority></url>
  <url><loc>{{ '/audiobook-library/' | absoluteUrl }}</loc><changefreq>monthly</changefreq><priority>0.6</priority></url>
  <url><loc>{{ '/search/' | absoluteUrl }}</loc><changefreq>yearly</changefreq><priority>0.3</priority></url>
  <url><loc>{{ '/tags/' | absoluteUrl }}</loc><changefreq>weekly</changefreq><priority>0.4</priority></url>
  {%- for tag in collections.tags %}
  <url><loc>{{ ('/tags/' ~ (tag | slug) ~ '/') | absoluteUrl }}</loc><changefreq>weekly</changefreq><priority>0.3</priority></url>
  {%- endfor %}
  {%- for article in collections.articles %}
  <url>
    <loc>{{ article.url | absoluteUrl }}</loc>
    <lastmod>{{ (article.data.updatedDate or article.data.pubDate) | isoDate }}</lastmod>
    <changefreq>yearly</changefreq>
    <priority>0.8</priority>
  </url>
  {%- endfor %}
</urlset>
