---
import BaseLayout from '../layouts/BaseLayout.astro';
import ResourceCard from '../components/ResourceCard.astro';
import AudioPlayer from '../components/AudioPlayer.astro';
import audiobookLibraryData from '../content/data/audiobook-library.json';
---

<BaseLayout title="Biblioteca de Audiolivros" description="Material educativo em formato áudio, reproduzível diretamente no navegador." lang="pt-PT">
  <div class="container py-12">
    <header class="mb-12">
      <h1 class="text-3xl font-bold text-gptclone-text-light mb-2">Biblioteca de Audiolivros</h1>
      <p class="text-gptclone-text-light-secondary">Ouça conteúdo educativo diretamente no navegador. Organizado por categoria e tópico.</p>
    </header>

    <div class="flex flex-wrap gap-2 mb-8">
      <span class="badge badge-category">Todos</span>
      <span class="badge badge-tag">IA Fundamentos</span>
      <span class="badge badge-tag">LLM</span>
      <span class="badge badge-tag">Arquitetura</span>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {audiobookLibraryData.audiobooks.map((audio) => (
        <ResourceCard
          title={audio.title}
          description={audio.description}
          category={audio.category}
          tags={audio.tags}
          author={audio.author}
          license={audio.license}
          language={audio.language}
          duration={audio.durationDisplay}
          downloadUrl={audio.downloadUrl}
          isSample={audio.sample}
          isPlaceholder={audio.placeholder}
          type="audiobook"
        />
      ))}
    </div>

    <section class="mt-16">
      <h2 class="text-2xl font-bold text-gptclone-text-light mb-6">Reprodução de áudio</h2>
      {audiobookLibraryData.audiobooks.some((a) => a.placeholder) && (
        <AudioPlayer isPlaceholder title="Audiolivro de exemplo (em breve)" />
      )}
      <div class="mt-6 p-6 rounded-lg bg-gptclone-purple-100 dark:bg-gptclone-purple-900/30 border border-gptclone-purple-200 dark:border-gptclone-purple-500/30">
        <h3 class="text-lg font-bold text-gptclone-purple-700 dark:text-gptclone-purple-300 mb-2">Sobre o conteúdo áudio</h3>
        <p class="text-gptclone-purple-900 dark:text-gptclone-text/70 text-sm">
          Os itens marcados como "Em breve" são marcadores de posição para futuros audiolivros.
          A arquitetura está preparada para suportar áudio gerado a partir de materiais educativos do GPTCLONE.
          Adicione ficheiros de áudio ao diretório <code>public/resources/audiobooks/</code> e atualize o ficheiro <code>content/data/audiobook-library.json</code>.
        </p>
      </div>
    </section>
  </div>
</BaseLayout>